{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/components/icons/MoonIcon.jsx",
    "src/app/not-found.tsx",
    "src/store/cartStore.ts",
    "src/components/cart/resume_cart_nav.jsx",
    "src/app/admin/test/page.jsx",
    "src/app/admin/page.jsx",
    "src/app/admin/create-products/page.jsx",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // Los tests corren con `node --test`, que exige la extension .ts en los
    // imports; tsc la rechaza salvo con allowImportingTsExtensions. Quedan
    // afuera de la compilacion porque no son parte del bundle.
    "**/*.test.ts"
  ]
}
