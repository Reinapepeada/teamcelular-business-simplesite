# Google Places API Configuration
# Obtené tu API key siguiendo la guía abajo
GOOGLE_PLACES_API_KEY=tu_api_key_aqui
GOOGLE_PLACE_ID=tu_place_id_aqui

# Base URL del sitio
NEXT_PUBLIC_BASE_URL=https://teamcelular.com

# Base URL de la API FastAPI usada por el sitio y el panel de admin
NEXT_PUBLIC_API_URL=https://fastapi-teamcelular-dev.up.railway.app

# Rating de Google que alimenta aggregateRating en el schema LocalBusiness.
# Si no estan seteadas, el bloque aggregateRating no se emite.
# Deben coincidir con lo que se muestra visible en el sitio y con el GBP real.
NEXT_PUBLIC_GOOGLE_RATING=4.9
NEXT_PUBLIC_GOOGLE_RATING_COUNT=362
