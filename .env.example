# Variables públicas de PostHog administradas por la integración de Vercel
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=your_posthog_host

# Origen canónico; los errores del servidor sólo se envían en Vercel Production
NEXT_PUBLIC_BASE_URL=https://teamcelular.com
